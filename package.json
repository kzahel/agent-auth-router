{
  "name": "agent-auth-router",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Local gateway that pools Claude Code and Codex subscription accounts with quota-aware routing; the official CLIs handle sign-in and refresh",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "aar": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 'test/**/*.test.ts'",
    "integration:prepare": "node integration/yepanywhere/prepare.mjs",
    "test:integration": "node --test --test-concurrency=1 'integration/yepanywhere/*.test.mjs'",
    "check": "npm run typecheck && npm test",
    "aar": "node src/cli.ts",
    "dev": "node src/cli.ts serve --dev"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2"
  }
}
